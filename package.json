{
  "name": "agent-waker",
  "version": "0.1.0",
  "description": "Align coding-agent subscription windows with when you work.",
  "keywords": [
    "cli",
    "claude-code",
    "codex",
    "coding-agent",
    "scheduler",
    "launchd",
    "subscription",
    "usage-window"
  ],
  "homepage": "https://github.com/andreacappadona17/agent-waker#readme",
  "bugs": {
    "url": "https://github.com/andreacappadona17/agent-waker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreacappadona17/agent-waker.git"
  },
  "license": "MIT",
  "author": "Andrea Cappadona",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "imports": {
    "#src/*.js": "./src/*.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
